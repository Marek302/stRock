FROM nginx:latest

COPY nginx.prod.conf /etc/nginx/nginx.conf.template
COPY proxy_params /etc/nginx/proxy_params
COPY proxy_params_websocket /etc/nginx/proxy_params_websocket

EXPOSE 80
EXPOSE 443

CMD ["/bin/sh", "-c", "envsubst '$SSL_CERT_PATH $SSL_KEY_PATH' < /etc/nginx/nginx.conf.template > /etc/nginx/nginx.conf && nginx -g 'daemon off;'"]